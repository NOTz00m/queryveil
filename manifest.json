{
  "manifest_version": 3,
  "name": "QueryVeil",
  "version": "1.3.0",
  "description": "Privacy-focused search cover with human-shaped timing, ghost personas, trends, and multilingual queries.",
  
  "icons": {
    "32": "icons/icon-32-nobg.png",
    "64": "icons/icon-64-nobg.png"
  },

  "host_permissions": [
    "https://www.google.com/*",
    "https://trends.google.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*"
  ],

  "permissions": [
    "storage",
    "alarms"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "scripts": ["background/service-worker.js"],
    "type": "module"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "queryveil@privacy.extension",
      "strict_min_version": "112.0"
    }
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-64-nobg.png",
    "default_title": "QueryVeil"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}

