{
  "name": "queryveil",
  "version": "1.3.0",
  "description": "Privacy-focused search cover extension for Firefox",
  "type": "module",
  "scripts": {
    "start": "web-ext run --source-dir=. --browser-console",
    "build": "web-ext build --source-dir=. --artifacts-dir=dist --overwrite-dest",
    "lint": "web-ext lint --source-dir=.",
    "sign": "web-ext sign --source-dir=. --artifacts-dir=dist",
    "test": "node --test benchmark/*.test.js",
    "benchmark": "node benchmark/benchmark.js"
  },
  "keywords": [
    "privacy",
    "security",
    "search",
    "obfuscation",
    "firefox",
    "extension",
    "anti-tracking"
  ],
  "author": "QueryVeil Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NOTz00m/queryveil.git"
  },
  "bugs": {
    "url": "https://github.com/NOTz00m/queryveil/issues"
  },
  "homepage": "https://github.com/NOTz00m/queryveil#readme",
  "devDependencies": {
    "web-ext": "^7.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "webExt": {
    "ignoreFiles": [
      "benchmark",
      "benchmark/**",
      "dist/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "icons/icon-32.png",
      "icons/icon-64.png"
    ]
  },
  "private": false
}
